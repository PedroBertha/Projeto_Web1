NODE_ENV=development
PORT=3000
# Banco local do docker-compose.yml (raiz do repositório). Em produção, use a URL do Neon.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/project_manager?schema=public
# Segredo do cookie de sessão (32+ caracteres; obrigatório em produção). Vazio em
# desenvolvimento: o servidor gera um temporário e as sessões caem a cada reinício.
SESSION_SECRET=
# Endereço do frontend, usado no link de confirmação de e-mail.
APP_URL=http://localhost:5173

# E-mail por SMTP (opcional). Sem SMTP_HOST, os e-mails aparecem no terminal.
# Gmail: smtp.gmail.com, porta 587 e uma senha de app em SMTP_PASS.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Nexo <seu-email@gmail.com>"

# Login com Google (opcional). Crie um "ID do cliente OAuth" (Aplicativo da Web)
# no Google Cloud Console e cadastre o GOOGLE_REDIRECT_URI como URI autorizado.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

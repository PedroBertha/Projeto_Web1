// Itens marcados com "SQL manual" estão no fim da migração init, porque o Prisma não os expressa no schema.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------- Enums ----------

enum ProjectRole {
  ADMIN
  MEMBER // "MEMBRO" na interface

  @@map("project_role")
}

// Permissões de um MEMBER no projeto. ADMIN tem todas, sem consultar a lista.
// Convidar e gerenciar membros é exclusivo de ADMIN, por isso não há permissão
// de convite: para alguém convidar, ele precisa ser promovido a ADMIN.
enum ProjectPermission {
  MANAGE_COLUMNS     // criar, renomear, reordenar e excluir colunas
  CREATE_TASKS
  EDIT_TASKS         // editar qualquer tarefa (sem ela, só as que criou ou de que é responsável)
  MOVE_TASKS         // mudar tarefa de coluna e de posição
  DELETE_TASKS
  ASSIGN_TASKS       // definir o responsável de qualquer tarefa
  UPLOAD_ATTACHMENTS

  @@map("project_permission")
}

enum ColumnStatus {
  TODO        // A FAZER
  IN_PROGRESS // EM ANDAMENTO
  DONE        // CONCLUÍDO

  @@map("column_status")
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT

  @@map("task_priority")
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  DECLINED
  EXPIRED
  REVOKED

  @@map("invitation_status")
}

enum UserTokenType {
  EMAIL_VERIFICATION
  PASSWORD_RESET

  @@map("user_token_type")
}

// ---------- Usuários e autenticação ----------

model User {
  id                Int       @id @default(autoincrement())
  name              String    @db.VarChar(100)
  username          String    @unique @db.VarChar(30) // guardado em minúsculas
  email             String    @unique @db.VarChar(254) // guardado em minúsculas
  passwordHash      String    @map("password_hash") @db.Text
  avatarUrl         String?   @map("avatar_url") @db.Text
  emailVerifiedAt   DateTime? @map("email_verified_at") @db.Timestamptz(3)
  passwordChangedAt DateTime? @map("password_changed_at") @db.Timestamptz(3)
  lastLoginAt       DateTime? @map("last_login_at") @db.Timestamptz(3)
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  memberships         ProjectMember[]
  tokens              UserToken[]
  createdProjects     Project[]       @relation("ProjectCreator")
  createdTasks        Task[]          @relation("TaskCreator")
  sentInvitations     Invitation[]    @relation("InvitationSender")
  receivedInvitations Invitation[]    @relation("InvitationInvitee")
  uploadedAttachments Attachment[]

  @@map("users")
}

// Sessões do express-session, gravadas pelo connect-pg-simple
// (configurar tableName: 'sessions' e createTableIfMissing: false; a tabela vem da migração).
// Formato exigido pelo connect-pg-simple: sid, sess (json), expire. O id do usuário fica
// dentro de sess (sess.userId), por isso não há FK para users.
// SQL manual: índice em (sess->>'userId') para encerrar todas as sessões de um usuário.
model Session {
  sid    String   @id @db.VarChar(255)
  sess   Json     @db.Json
  expire DateTime @db.Timestamp(6)

  @@index([expire])
  @@map("sessions")
}

// Confirmação de e-mail e recuperação de senha (uso único).
model UserToken {
  id        String        @id @default(uuid(7)) @db.Uuid
  userId    Int           @map("user_id")
  type      UserTokenType
  tokenHash String        @unique @map("token_hash") @db.Char(64)
  expiresAt DateTime      @map("expires_at") @db.Timestamptz(3)
  usedAt    DateTime?     @map("used_at") @db.Timestamptz(3)
  createdAt DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
  @@map("user_tokens")
}

// ---------- Projetos ----------

model Project {
  id          String    @id @default(uuid(7)) @db.Uuid
  name        String    @db.VarChar(100)
  description String    @default("") @db.VarChar(2000)
  startDate   DateTime? @map("start_date") @db.Date
  dueDate     DateTime? @map("due_date") @db.Date // SQL manual: CHECK (due_date >= start_date)
  createdById Int?      @map("created_by_id")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  createdBy   User?           @relation("ProjectCreator", fields: [createdById], references: [id], onDelete: SetNull)
  members     ProjectMember[]
  columns     BoardColumn[]
  tasks       Task[]
  invitations Invitation[]
  attachments Attachment[]

  @@index([createdById])
  @@map("projects")
}

model ProjectMember {
  projectId String      @map("project_id") @db.Uuid
  userId    Int         @map("user_id")
  role        ProjectRole         @default(MEMBER)
  permissions ProjectPermission[] @default([CREATE_TASKS, EDIT_TASKS, MOVE_TASKS, UPLOAD_ATTACHMENTS])
  joinedAt  DateTime    @default(now()) @map("joined_at") @db.Timestamptz(3)

  project       Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user          User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  assignedTasks Task[]

  @@id([projectId, userId])
  @@index([userId])
  @@map("project_members")
}

model Invitation {
  id           String           @id @default(uuid(7)) @db.Uuid
  projectId    String           @map("project_id") @db.Uuid
  email        String           @db.VarChar(254) // minúsculas
  role         ProjectRole         @default(MEMBER)
  permissions  ProjectPermission[] @default([CREATE_TASKS, EDIT_TASKS, MOVE_TASKS, UPLOAD_ATTACHMENTS]) // oferecidas no convite
  tokenHash    String           @unique @map("token_hash") @db.Char(64)
  status       InvitationStatus @default(PENDING)
  invitedById  Int?             @map("invited_by_id")
  inviteeId    Int?             @map("invitee_id") // conta do convidado, quando existir (base da futura notificação)
  expiresAt    DateTime         @map("expires_at") @db.Timestamptz(3)
  respondedAt  DateTime?        @map("responded_at") @db.Timestamptz(3)
  createdAt    DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  project    Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  invitedBy  User?   @relation("InvitationSender", fields: [invitedById], references: [id], onDelete: SetNull)
  invitee    User?   @relation("InvitationInvitee", fields: [inviteeId], references: [id], onDelete: SetNull)

  // SQL manual: CREATE UNIQUE INDEX invitations_one_pending_per_email
  //   ON invitations (project_id, email) WHERE status = 'PENDING';
  @@index([projectId, status])
  @@index([email, status])
  @@index([inviteeId, status])
  @@map("invitations")
}

// ---------- Kanban ----------

model BoardColumn {
  id        String       @id @default(uuid(7)) @db.Uuid
  projectId String       @map("project_id") @db.Uuid
  name      String       @db.VarChar(50)
  status    ColumnStatus @default(TODO)
  position  String       @db.VarChar(64) // SQL manual: COLLATE "C"
  createdAt DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tasks   Task[]

  @@unique([projectId, id]) // alvo da FK composta de tasks
  @@unique([projectId, position])
  @@map("board_columns")
}

model Task {
  id          String       @id @default(uuid(7)) @db.Uuid
  projectId   String       @map("project_id") @db.Uuid
  columnId    String       @map("column_id") @db.Uuid
  title       String       @db.VarChar(200)
  description String       @default("") @db.Text
  priority    TaskPriority @default(MEDIUM)
  position    String       @db.VarChar(64) // SQL manual: COLLATE "C"
  startDate   DateTime?    @map("start_date") @db.Date
  dueDate     DateTime?    @map("due_date") @db.Date // SQL manual: CHECK (due_date >= start_date)
  completedAt DateTime?    @map("completed_at") @db.Timestamptz(3)
  assigneeId  Int?         @map("assignee_id")
  createdById Int?         @map("created_by_id")
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  project     Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  // FK composta: garante que a coluna é do mesmo projeto. NoAction impede apagar coluna com tarefas (checado no fim do comando, o que deixa o cascade do projeto funcionar).
  column      BoardColumn    @relation(fields: [projectId, columnId], references: [projectId, id], onDelete: NoAction)
  // FK composta: garante que o responsável é membro do projeto.
  assignee    ProjectMember? @relation(fields: [projectId, assigneeId], references: [projectId, userId], onDelete: NoAction)
  createdBy   User?          @relation("TaskCreator", fields: [createdById], references: [id], onDelete: SetNull)
  attachments Attachment[]

  @@unique([projectId, id]) // alvo da FK composta de attachments
  @@unique([columnId, position])
  @@index([projectId, assigneeId])
  @@index([createdById])
  @@index([projectId, dueDate])
  @@map("tasks")
}

// Anexo do projeto (task_id nulo) ou de uma tarefa. Por enquanto só imagens.
model Attachment {
  id           String   @id @default(uuid(7)) @db.Uuid
  projectId    String   @map("project_id") @db.Uuid
  taskId       String?  @map("task_id") @db.Uuid
  url          String   @db.Text
  storageKey   String   @unique @map("storage_key") @db.Text // caminho no storage, para apagar o arquivo
  fileName     String   @map("file_name") @db.VarChar(255)
  mimeType     String   @map("mime_type") @db.VarChar(100) // SQL manual: CHECK (mime_type IN ('image/jpeg','image/png','image/webp','image/gif'))
  sizeBytes    Int      @map("size_bytes") // SQL manual: CHECK (size_bytes > 0)
  uploadedById Int?     @map("uploaded_by_id")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  project    Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  task       Task?   @relation(fields: [projectId, taskId], references: [projectId, id], onDelete: Cascade)
  uploadedBy User?   @relation(fields: [uploadedById], references: [id], onDelete: SetNull)

  @@index([projectId])
  @@index([taskId])
  @@index([uploadedById])
  @@map("attachments")
}
